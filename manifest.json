{
  "manifest_version": 3,
  "name": "NetAcad Auto Master & Next",
  "version": "2.0.0",
  "description": "Auto-answer correct questions (Adapt Framework inspection & AI Fallback) and auto-advance across modules and sub-topics.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "*://*.netacad.com/*",
    "*://*.skillsforall.com/*",
    "*://*.cisco.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.netacad.com/*",
        "*://*.skillsforall.com/*",
        "*://*.cisco.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "*://*.netacad.com/*",
        "*://*.skillsforall.com/*",
        "*://*.cisco.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NetAcad Auto Master",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
